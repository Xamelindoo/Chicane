<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.NewsPage"
             x:DataType="viewmodels:NewsViewModel"
             Title="News"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="20,6,20,4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#111827" Offset="0" />
                    <GradientStop Color="#1e1b4b" Offset="0.5" />
                    <GradientStop Color="#4c1d95" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="&#x1F3C1;" FontSize="14" VerticalOptions="Center" />
                    <Label Text="CHICANE" FontFamily="OutfitBold" FontSize="20"
                           FontAttributes="Italic" TextColor="White" VerticalOptions="Center"
                           CharacterSpacing="2" />
                </HorizontalStackLayout>
                <Border StrokeThickness="0" Padding="4" VerticalOptions="Center"
                        HorizontalOptions="End">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#x2699;" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsBusy}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600" HeightRequest="40" WidthRequest="40" />
            <Label Text="&#x1F3CE; Loading news..." FontFamily="TitilliumWebRegular" FontSize="12" TextColor="#9CA3AF" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasError}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}" FontFamily="TitilliumWebBold" FontSize="14" TextColor="#9CA3AF" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="RETRY"
                    Command="{Binding LoadCommand}"
                    BackgroundColor="#E10600"
                    TextColor="White"
                    FontFamily="TitilliumWebBold"
                    FontSize="12"
                    CornerRadius="4"
                    Padding="24,10"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Empty State -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmptyState}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32">
            <Label Text="&#x1F4F0;" FontSize="48" HorizontalOptions="Center" />
            <Label Text="No news articles yet" FontFamily="TitilliumWebRegular" FontSize="14"
                   TextColor="#9CA3AF" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- News List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView VerticalScrollBarVisibility="Never"
                         ItemsSource="{Binding Articles}"
                         IsVisible="{Binding HasData}"
                         x:DataType="viewmodels:NewsViewModel"
                        Margin="0,0,0,0">
            <CollectionView.Header>
                <Label Text="ULTIME NOTIZIE"
                       FontFamily="TitilliumWebBold"
                       FontSize="16"
                       TextColor="#E2E8F0"
                       CharacterSpacing="2"
                       Margin="20,16,20,10" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NewsItem">
                    <Border StrokeThickness="1"
                            Stroke="#2a3441"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#1e293b"
                            Margin="16,0,16,10"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:NewsViewModel}}, Path=OpenArticleCommand}"
                                CommandParameter="{Binding SourceUrl}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="96,*"
                              ColumnSpacing="14">
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}"
                                   WidthRequest="96"
                                   HeightRequest="96"
                                   Aspect="AspectFill"
                                   VerticalOptions="Center">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,96,96" />
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontFamily="TitilliumWebBold"
                                       FontSize="13"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="3" />
                                <Label Text="{Binding TimeAgo}"
                                       FontFamily="TitilliumWebRegular"
                                       FontSize="11"
                                       TextColor="#9CA3AF" />
                                <Label Text="{Binding Source}"
                                       FontFamily="TitilliumWebBold"
                                       FontSize="10"
                                       TextColor="#E10600"
                                       CharacterSpacing="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
