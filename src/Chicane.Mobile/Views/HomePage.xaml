<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             x:Class="Chicane.Mobile.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Home">

    <Grid RowDefinitions="*" BackgroundColor="{StaticResource CarbonBlack}">
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="16">

            <Border Style="{StaticResource PlaceholderCard}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="CHICANE"
                        Style="{StaticResource Headline}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Hero Section"
                        Style="{StaticResource SubHeadline}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Countdown, live data and track map will appear here."
                        Style="{StaticResource Caption}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
