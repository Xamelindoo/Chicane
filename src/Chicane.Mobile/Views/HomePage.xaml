<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="Home"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*" BackgroundColor="{StaticResource CarbonBlack}">

        <!-- Loading State -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource RacingRed}"
                               HeightRequest="48"
                               WidthRequest="48" />
            <Label Text="Loading race data..."
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error State -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="32">
            <Label Text="&#x26A0;"
                   FontSize="48"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource RacingRed}" />
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Button Text="RETRY"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Offline Banner -->
        <Border IsVisible="{Binding IsOffline}"
                BackgroundColor="{StaticResource RacingRed}"
                StrokeThickness="0"
                Padding="8,4"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="8,52,0,0">
            <Label Text="OFFLINE"
                   FontFamily="TitilliumWebBold"
                   FontSize="10"
                   TextColor="{StaticResource PureWhite}"
                   CharacterSpacing="3" />
        </Border>

        <!-- Scrollable Content -->
        <ScrollView x:Name="MainScrollView" IsVisible="{Binding HasData}">
            <VerticalStackLayout Spacing="0">

                <!-- ═══════════ HERO SECTION (100vh) ═══════════ -->
                <Grid RowDefinitions="Auto,*"
                      HeightRequest="{Binding HeroHeight}"
                       Padding="20,28,20,20">

                    <!-- Top: Category Pill + Event Label -->
                    <VerticalStackLayout Grid.Row="0"
                                         HorizontalOptions="Center"
                                          Spacing="16">
                        <Label x:Name="CategoryPill"
                               HorizontalOptions="Center"
                               InputTransparent="False" />
                        <Label Text="NEXT EVENT"
                               FontFamily="TitilliumWebRegular"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center"
                               CharacterSpacing="4" />
                        <Label Text="{Binding EventName}"
                               Style="{StaticResource Headline}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CircuitLocation}"
                               FontFamily="TitilliumWebRegular"
                               FontSize="12"
                               TextColor="{StaticResource CoolSlate}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Toggle Button (debug, top-right) -->
                    <Border Grid.Row="0"
                            Stroke="{StaticResource PureWhite}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="#20FFFFFF"
                            Padding="10,4"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,5,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SimulateLiveCommand}" />
                        </Border.GestureRecognizers>
                        <Label FontFamily="TitilliumWebSemiBold"
                               FontSize="9"
                               TextColor="{StaticResource PureWhite}"
                               CharacterSpacing="2">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPreRace}" Value="True">
                                    <Setter Property="Text" Value="LIVE" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPreRace}" Value="False">
                                    <Setter Property="Text" Value="PRE-RACE" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Center: Circuit Map + Countdown (Pre-Race) or Live Data -->
                    <Grid Grid.Row="1"
                          VerticalOptions="End"
                          HorizontalOptions="Center">

                        <!-- Pre-Race Countdown -->
                        <VerticalStackLayout IsVisible="{Binding IsPreRace}"
                                             Spacing="10"
                                             HorizontalOptions="Center">

                            <!-- Circuit Map -->
                            <Image Source="{Binding CircuitMapUrl}"
                                   IsVisible="{Binding HasCircuitMap}"
                                   Aspect="AspectFit"
                                   HeightRequest="140"
                                   HorizontalOptions="Center" />

                            <FlexLayout Direction="Row"
                                        AlignItems="Center"
                                        JustifyContent="Center"
                                        BindableLayout.ItemsSource="{Binding CountdownParts}"
                                        x:DataType="viewmodels:HomeViewModel">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CountdownPart">
                                        <Label Text="{Binding Text}"
                                               FontFamily="JetBrainsMonoBold"
                                               FontSize="54"
                                               TextColor="{StaticResource RacingRed}"
                                               CharacterSpacing="0.7">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsColon}"
                                                             Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Label Text="DD:HH:MM:SS"
                                   FontFamily="JetBrainsMonoRegular"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="Center"
                                   CharacterSpacing="3" />

                            <!-- Weather Badge (tappable) -->
                            <Border Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="{StaticResource SurfaceLow}"
                                    Padding="8,4"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding IsPreRace}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleWeatherDetailCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding WeatherForecast.IconGlyph}"
                                           FontSize="14"
                                           VerticalOptions="Center" />
                                    <!-- Normal weather -->
                                    <Label FontFamily="TitilliumWebRegular"
                                           FontSize="11"
                                           TextColor="{StaticResource CoolSlate}"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding WeatherForecast.IsApproximate, FallbackValue=False, Converter={x:Null}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding WeatherForecast.IsApproximate}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} - {1}°C">
                                                <Binding Path="WeatherForecast.Condition" FallbackValue="N/A" />
                                                <Binding Path="WeatherForecast.TemperatureC" FallbackValue="--" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <!-- Approximate weather -->
                                    <Label Text="{Binding WeatherForecast.Condition}"
                                           FontFamily="TitilliumWebRegular"
                                           FontSize="11"
                                           TextColor="{StaticResource CoolSlate}"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding WeatherForecast.IsApproximate}" Value="False">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Approximate Warning Tooltip -->
                            <Label Text="Previsioni scarse"
                                   IsVisible="{Binding ShowApproximateWarning}"
                                   FontFamily="TitilliumWebRegular"
                                   FontSize="9"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="Center"
                                   Margin="0,2,0,0" />

                        </VerticalStackLayout>

                        <!-- Live Session Data -->
                        <VerticalStackLayout IsVisible="{Binding IsLive}"
                                             Spacing="12"
                                             HorizontalOptions="Center">
                            <Border Stroke="{StaticResource RacingRed}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="{StaticResource RacingRed}"
                                    Padding="12,4"
                                    HorizontalOptions="Center">
                                <Label Text="{Binding SessionStatus}"
                                       FontFamily="TitilliumWebBold"
                                       FontSize="14"
                                       TextColor="{StaticResource PureWhite}"
                                       CharacterSpacing="4" />
                            </Border>
                            <Label Text="{Binding SessionName}"
                                   FontFamily="TitilliumWebBold"
                                   FontSize="28"
                                   TextColor="{StaticResource PureWhite}"
                                   HorizontalOptions="Center" />
                            <Label FontFamily="TitilliumWebRegular"
                                   FontSize="36"
                                   TextColor="{StaticResource PureWhite}"
                                   HorizontalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}">
                                        <Binding Path="CurrentLap" />
                                        <Binding Path="TotalLaps" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Text="LAPS"
                                   FontFamily="TitilliumWebRegular"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="Center"
                                   CharacterSpacing="3" />

                            <CollectionView ItemsSource="{Binding PositionBoard}"
                                            Margin="0,12,0,0">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriverGap">
                                        <Grid ColumnDefinitions="32,*,Auto"
                                              Padding="0,4"
                                              ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Position}"
                                                   FontFamily="TitilliumWebBold"
                                                   FontSize="16"
                                                   TextColor="{StaticResource RacingRed}"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="1">
                                                <Label Text="{Binding DriverName}"
                                                       FontFamily="TitilliumWebRegular"
                                                       FontSize="13"
                                                       TextColor="{StaticResource PureWhite}" />
                                                <Label Text="{Binding TeamName}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextMuted}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{StaticResource SurfaceHigh}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 4"
                                                    Padding="8,3"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding GapDisplay}"
                                                       FontFamily="TitilliumWebBold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource PureWhite}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <!-- ═══════════ STANDINGS SECTION (Pre-Race scroll) ═══════════ -->
                <VerticalStackLayout IsVisible="{Binding IsPreRace}"
                                     Padding="20,0,20,40"
                                     Spacing="16">

                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{StaticResource SurfaceLow}"
                            Padding="16">
                        <Label Text="DRIVER STANDINGS"
                               FontFamily="TitilliumWebBold"
                               FontSize="14"
                               TextColor="{StaticResource PureWhite}"
                               CharacterSpacing="4"
                               HorizontalOptions="Center" />
                    </Border>

                    <Grid ColumnDefinitions="36,*,Auto"
                          Padding="0,0,0,4"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="#"
                               FontFamily="TitilliumWebBold"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="2" />
                        <Label Grid.Column="1"
                               Text="DRIVER"
                               FontFamily="TitilliumWebBold"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="2" />
                        <Label Grid.Column="2"
                               Text="PTS"
                               FontFamily="TitilliumWebBold"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="2" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Standings}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StandingsEntry">
                                <Grid ColumnDefinitions="36,*,Auto"
                                      Padding="0,5"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Position}"
                                           FontFamily="TitilliumWebBold"
                                           FontSize="13"
                                           TextColor="{StaticResource PureWhite}"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="1">
                                        <Label Text="{Binding DriverName}"
                                               FontFamily="TitilliumWebRegular"
                                               FontSize="13"
                                               TextColor="{StaticResource PureWhite}" />
                                        <Label Text="{Binding TeamName}"
                                               FontSize="10"
                                               TextColor="{StaticResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding Points}"
                                           FontFamily="TitilliumWebBold"
                                           FontSize="14"
                                           TextColor="{StaticResource RacingRed}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Constructor Standings -->
                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{StaticResource SurfaceLow}"
                            Padding="16"
                            Margin="0,24,0,0">
                        <Label Text="CONSTRUCTOR STANDINGS"
                               FontFamily="TitilliumWebBold"
                               FontSize="14"
                               TextColor="{StaticResource PureWhite}"
                               CharacterSpacing="4"
                               HorizontalOptions="Center" />
                    </Border>

                    <Grid ColumnDefinitions="36,*,Auto"
                          Padding="0,0,0,4"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="#"
                               FontFamily="TitilliumWebBold"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="2" />
                        <Label Grid.Column="1"
                               Text="TEAM"
                               FontFamily="TitilliumWebBold"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="2" />
                        <Label Grid.Column="2"
                               Text="PTS"
                               FontFamily="TitilliumWebBold"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               CharacterSpacing="2" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding ConstructorStandings}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ConstructorStandingsEntry">
                                <Grid ColumnDefinitions="36,*,Auto"
                                      Padding="0,5"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Position}"
                                           FontFamily="TitilliumWebBold"
                                           FontSize="13"
                                           TextColor="{StaticResource PureWhite}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding TeamName}"
                                           FontFamily="TitilliumWebRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource PureWhite}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Points}"
                                           FontFamily="TitilliumWebBold"
                                           FontSize="14"
                                           TextColor="{StaticResource RacingRed}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ═══════════ LIVE TRACK SECTION (Live scroll) ═══════════ -->
                <VerticalStackLayout IsVisible="{Binding IsLive}"
                                     Padding="20,0,20,40"
                                     Spacing="16">
                    <Label Text="SCROLL DOWN FOR TRACK MAP"
                           FontFamily="TitilliumWebRegular"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center"
                           CharacterSpacing="2"
                           Margin="0,0,0,8" />

                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{StaticResource SurfaceLow}"
                            Padding="16">
                        <Label Text="LIVE TRACK"
                               FontFamily="TitilliumWebBold"
                               FontSize="14"
                               TextColor="{StaticResource RacingRed}"
                               CharacterSpacing="4"
                               HorizontalOptions="Center" />
                    </Border>

                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{StaticResource TireSmoke}"
                            Padding="0"
                            HeightRequest="220">
                        <Image Source="circuit_placeholder.png"
                               Aspect="AspectFill"
                               Opacity="0.6" />
                    </Border>

                    <Label Text="TRACK POSITIONS"
                           FontFamily="TitilliumWebBold"
                           FontSize="12"
                           TextColor="{StaticResource PureWhite}"
                           CharacterSpacing="3"
                           Margin="0,8,0,0" />

                    <CollectionView ItemsSource="{Binding TrackPositions}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackPosition">
                                <Grid ColumnDefinitions="28,*,Auto,Auto"
                                      Padding="0,6"
                                      ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Position}"
                                           FontFamily="TitilliumWebBold"
                                           FontSize="14"
                                           TextColor="{StaticResource RacingRed}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding DriverName}"
                                           FontFamily="TitilliumWebRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource PureWhite}"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="2"
                                            BackgroundColor="{StaticResource SurfaceHigh}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="8,3"
                                            VerticalOptions="Center">
                                        <Label FontFamily="TitilliumWebRegular"
                                               FontSize="11"
                                               TextColor="{StaticResource CoolSlate}">
                                            <Label.Text>
                                                <Binding Path="Sector"
                                                         StringFormat="S{0}" />
                                            </Label.Text>
                                        </Label>
                                    </Border>
                                    <Label Grid.Column="3"
                                           Text="{Binding LastTime}"
                                           FontFamily="TitilliumWebBold"
                                           FontSize="13"
                                           TextColor="{StaticResource PureWhite}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════ SCROLL AFFORDANCE OVERLAY ═══════════ -->
        <VerticalStackLayout IsVisible="{Binding IsAtScrollTop}"
                             InputTransparent="True"
                             VerticalOptions="End"
                             HorizontalOptions="Fill"
                             Margin="0,0,0,8"
                             Spacing="0">
            <BoxView HeightRequest="60"
                     Color="{StaticResource CarbonBlack}"
                     Opacity="0.0">
                <BoxView.Behaviors>
                    <!-- Gradient scrim effect via layered opacity -->
                </BoxView.Behaviors>
            </BoxView>
            <BoxView HeightRequest="40"
                     VerticalOptions="Start"
                     HorizontalOptions="Fill"
                     Color="{StaticResource CarbonBlack}"
                     Opacity="0.7" />
            <BoxView HeightRequest="1"
                     VerticalOptions="Start"
                     HorizontalOptions="Fill"
                     Color="{StaticResource BorderSubtle}"
                     Opacity="0.5" />
            <VerticalStackLayout VerticalOptions="End"
                                 HorizontalOptions="Center"
                                 Spacing="6"
                                 Padding="0,16,0,20"
                                 BackgroundColor="#E60A0A0A">
                <Label Text="&#x2304;"
                       FontSize="20"
                       TextColor="{StaticResource CoolSlate}"
                       HorizontalOptions="Center" />
                <Label Text="SCROLL FOR STANDINGS"
                       FontFamily="TitilliumWebRegular"
                       FontSize="10"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       CharacterSpacing="3" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Category Switcher Overlay (on top of everything, z-order last = on top) -->
        <ContentView x:Name="CategorySwitcherHost"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill" />

        <!-- ═══════════ WEATHER DETAIL MODAL ═══════════ -->
        <Border IsVisible="{Binding ShowWeatherDetail}"
                BackgroundColor="#F00A0A0A"
                StrokeThickness="0"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                InputTransparent="False">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseWeatherDetailCommand}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource CarbonBlack}"
                        Padding="24,20" WidthRequest="320">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer /> <!-- stop propagation -->
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{Binding EventName, StringFormat='{0} WEATHER'}"
                               FontFamily="TitilliumWebBold" FontSize="15"
                               TextColor="{StaticResource PureWhite}"
                               HorizontalOptions="Center" />
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        <Label Text="{Binding WeatherForecast.IconGlyph}"
                               FontSize="40" HorizontalOptions="Center" />
                        <Label Text="{Binding WeatherForecast.Condition}"
                               FontFamily="TitilliumWebBold" FontSize="16"
                               TextColor="{StaticResource PureWhite}"
                               HorizontalOptions="Center" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              RowSpacing="12" ColumnSpacing="16" Margin="0,8,0,0">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="🌡 TEMP" FontSize="9"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="2" />
                                <Label Text="{Binding WeatherForecast.TemperatureC, StringFormat='{0}°C'}"
                                       FontFamily="TitilliumWebBold" FontSize="18"
                                       TextColor="{StaticResource PureWhite}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Label Text="💨 WIND" FontSize="9"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="2" />
                                <Label Text="{Binding WeatherForecast.WindSpeed, StringFormat='{0:F0} km/h'}"
                                       FontFamily="TitilliumWebBold" FontSize="18"
                                       TextColor="{StaticResource PureWhite}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="💧 HUMIDITY" FontSize="9"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="2" />
                                <Label Text="{Binding WeatherForecast.Humidity, StringFormat='{0}%'}"
                                       FontFamily="TitilliumWebBold" FontSize="18"
                                       TextColor="{StaticResource PureWhite}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="📊 PRESSURE" FontSize="9"
                                       TextColor="{StaticResource TextMuted}"
                                       CharacterSpacing="2" />
                                <Label Text="{Binding WeatherForecast.Pressure, StringFormat='{0} hPa'}"
                                       FontFamily="TitilliumWebBold" FontSize="18"
                                       TextColor="{StaticResource PureWhite}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        <Button Text="CLOSE"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CloseWeatherDetailCommand}"
                                HorizontalOptions="Center" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
