<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamsPage"
             x:DataType="viewmodels:TeamsViewModel"
             Title="Teams"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource CarbonBlack}">

        <!-- Header -->
        <Border Grid.Row="0"
                Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="{StaticResource SurfaceLow}"
                Padding="20,48,20,12">
            <Label Text="CONSTRUCTOR STANDINGS"
                   FontFamily="SpaceMonoBold"
                   FontSize="14"
                   TextColor="{StaticResource PureWhite}"
                   CharacterSpacing="4"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource RacingRed}"
                               HeightRequest="48"
                               WidthRequest="48" />
            <Label Text="Loading teams..."
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="32">
            <Label Text="&#x26A0;"
                   FontSize="48"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource RacingRed}" />
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />
            <Button Text="RETRY"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Teams List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Teams}"
                        IsVisible="{Binding HasData}"
                        Margin="0,0,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TeamEntry">
                    <Grid ColumnDefinitions="4,*"
                          Margin="16,0,16,10">

                        <!-- Left color bar -->
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 Color="{Binding BorderColor}"
                                 VerticalOptions="Fill" />

                        <!-- Team card content -->
                        <Border Grid.Column="1"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 0,4,4,0"
                                BackgroundColor="{StaticResource SurfaceLow}"
                                Padding="16,14">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="8">

                                <!-- Row 0: Team Name + Position -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding TeamName}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="20"
                                       TextColor="{StaticResource PureWhite}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Position, StringFormat='#{0}'}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="20"
                                       TextColor="{StaticResource RacingRed}"
                                       VerticalOptions="Center" />

                                <!-- Row 1: Driver 1 -->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Drivers[0].Name}"
                                           FontFamily="SpaceMonoRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource CoolSlate}"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding Drivers[0].Points}"
                                               FontFamily="SpaceMonoBold"
                                               FontSize="13"
                                               TextColor="{StaticResource PureWhite}"
                                               VerticalOptions="Center" />
                                        <Label Text="pts"
                                               FontFamily="SpaceMonoRegular"
                                               FontSize="10"
                                               TextColor="{StaticResource TextMuted}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Row 2: Driver 2 -->
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Drivers[1].Name}"
                                           FontFamily="SpaceMonoRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource CoolSlate}"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding Drivers[1].Points}"
                                               FontFamily="SpaceMonoBold"
                                               FontSize="13"
                                               TextColor="{StaticResource PureWhite}"
                                               VerticalOptions="Center" />
                                        <Label Text="pts"
                                               FontFamily="SpaceMonoRegular"
                                               FontSize="10"
                                               TextColor="{StaticResource TextMuted}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Row 3: Total team points -->
                                <Label Grid.Row="3" Grid.Column="1"
                                       Text="{Binding Points}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="20"
                                       TextColor="{StaticResource PureWhite}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
