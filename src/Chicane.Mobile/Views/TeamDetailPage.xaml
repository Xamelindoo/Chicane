<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamDetailPage"
             x:DataType="viewmodels:TeamDetailViewModel"
             Title="{Binding TeamName}"
             BackgroundColor="{StaticResource CarbonBlack}">

    <Grid RowDefinitions="*">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RacingRed}" HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading team..." Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="{StaticResource RacingRed}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" />
            <Button Text="RETRY" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView IsVisible="{Binding HasData}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,0">

                <!-- Gradient Factory Image Placeholder -->
                <Border StrokeThickness="0" HeightRequest="180">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{Binding GradientColor}" Offset="0.0" />
                            <GradientStop Color="{StaticResource CarbonBlack}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Centered Team Name + Points -->
                <VerticalStackLayout Spacing="4" Padding="20,16">
                    <Label Text="{Binding TeamName}"
                           FontFamily="SpaceMonoBold" FontSize="24"
                           TextColor="{StaticResource PureWhite}"
                           HorizontalOptions="Center" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding TotalPoints}" FontFamily="SpaceMonoBold" FontSize="16"
                               TextColor="{StaticResource RacingRed}" VerticalOptions="Center" />
                        <Label Text="pts" FontFamily="SpaceMonoRegular" FontSize="12"
                               TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Drivers Section -->
                <Label Text="DRIVERS" FontFamily="SpaceMonoBold" FontSize="12"
                       TextColor="{StaticResource PureWhite}" CharacterSpacing="3"
                       Margin="20,12,20,10" />
                <CollectionView ItemsSource="{Binding Drivers}" x:DataType="viewmodels:TeamDetailViewModel">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DriverEntry">
                            <Grid ColumnDefinitions="4,*" Margin="20,0,20,8">
                                <BoxView Grid.Column="0" WidthRequest="4"
                                         Color="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamDetailViewModel}}, Path=BorderColor}"
                                         VerticalOptions="Fill" />
                                <Border Grid.Column="1" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 0,4,4,0" BackgroundColor="{StaticResource SurfaceLow}" Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontFamily="SpaceMonoRegular" FontSize="14"
                                               TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Points}" FontFamily="SpaceMonoBold" FontSize="14"
                                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                            <Label Text="pts" FontFamily="SpaceMonoRegular" FontSize="10"
                                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Race Results Header (tappable) -->
                <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="14" Margin="20,20,20,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRaceListCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="RACE RESULTS" FontFamily="SpaceMonoBold" FontSize="13"
                               TextColor="{StaticResource PureWhite}" CharacterSpacing="3" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding TotalPoints}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource RacingRed}" VerticalOptions="Center" />
                            <Label Text="pts" FontFamily="SpaceMonoRegular" FontSize="10"
                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Horizontal Race Scroll -->
                <ScrollView Orientation="Horizontal"
                            Margin="20,10,20,0"
                            HeightRequest="140">
                    <HorizontalStackLayout Spacing="0"
                                           BindableLayout.ItemsSource="{Binding RaceResults}"
                                           x:DataType="viewmodels:TeamDetailViewModel">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamRaceResult">
                                <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource SurfaceLow}"
                                        Padding="10,8" WidthRequest="175">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamDetailViewModel}}, Path=NavigateToRaceCommand}"
                                            CommandParameter="{Binding EventName}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding EventName}" FontFamily="SpaceMonoBold" FontSize="11"
                                               TextColor="{StaticResource PureWhite}" LineBreakMode="TailTruncation" />
                                        <Grid ColumnDefinitions="Auto,Auto">
                                            <Label Grid.Column="0" Text="{Binding TotalPoints}" FontFamily="SpaceMonoBold" FontSize="18"
                                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text=" pts" FontFamily="SpaceMonoRegular" FontSize="10"
                                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center" Margin="2,0,0,0" />
                                        </Grid>
                                        <Label FontFamily="SpaceMonoRegular" FontSize="10" TextColor="{StaticResource CoolSlate}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} {1} pts">
                                                    <Binding Path="Driver1Position" StringFormat="P{0}" />
                                                    <Binding Path="Driver1Points" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Label FontFamily="SpaceMonoRegular" FontSize="10" TextColor="{StaticResource CoolSlate}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} {1} pts">
                                                    <Binding Path="Driver2Position" StringFormat="P{0}" />
                                                    <Binding Path="Driver2Points" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Label Text="{Binding EventDate, StringFormat='{0:dd MMM}'}"
                                               FontFamily="SpaceMonoBold" FontSize="11"
                                               TextColor="{StaticResource CoolSlate}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ═══════════ SEASON RECORDS ═══════════ -->
                <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="16" Margin="20,24,20,0">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="SEASON RECORDS" FontFamily="SpaceMonoBold" FontSize="13"
                               TextColor="{StaticResource PureWhite}" CharacterSpacing="3" Margin="0,0,0,12" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.Championships, FallbackValue=True}">
                            <Label Grid.Column="0" Text="Championships" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.Championships}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.RaceWins, FallbackValue=True}">
                            <Label Grid.Column="0" Text="Race Wins" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.RaceWins}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.Podiums, FallbackValue=True}">
                            <Label Grid.Column="0" Text="Podiums" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.Podiums}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.PolePositions, FallbackValue=True}">
                            <Label Grid.Column="0" Text="Pole Positions" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.PolePositions}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.FastestLaps, FallbackValue=True}">
                            <Label Grid.Column="0" Text="Fastest Laps" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.FastestLaps}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.FirstSeason, FallbackValue=False}">
                            <Label Grid.Column="0" Text="First Season" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.FirstSeason}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding SeasonStats.HomeRace, FallbackValue=False}">
                            <Label Grid.Column="0" Text="Home Race" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding SeasonStats.HomeRace}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════ TEAM PROFILE ═══════════ -->
                <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="16" Margin="20,24,20,20">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="TEAM PROFILE" FontFamily="SpaceMonoBold" FontSize="13"
                               TextColor="{StaticResource PureWhite}" CharacterSpacing="3" Margin="0,0,0,12" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,6" ColumnSpacing="8"
                              IsVisible="{Binding Profile.FullName, FallbackValue=False}">
                            <Label Grid.Column="0" Text="{Binding Profile.FullName}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12"
                              IsVisible="{Binding Profile.Chassis, FallbackValue=False}">
                            <Label Grid.Column="0" Text="Chassis" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" WidthRequest="90" />
                            <Label Grid.Column="1" Text="{Binding Profile.Chassis}" FontFamily="SpaceMonoBold" FontSize="12"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12"
                              IsVisible="{Binding Profile.Base, FallbackValue=False}">
                            <Label Grid.Column="0" Text="Base" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" WidthRequest="90" />
                            <Label Grid.Column="1" Text="{Binding Profile.Base}" FontFamily="SpaceMonoBold" FontSize="12"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12"
                              IsVisible="{Binding Profile.PowerUnit, FallbackValue=False}">
                            <Label Grid.Column="0" Text="Power Unit" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" WidthRequest="90" />
                            <Label Grid.Column="1" Text="{Binding Profile.PowerUnit}" FontFamily="SpaceMonoBold" FontSize="12"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12"
                              IsVisible="{Binding Profile.TeamPrincipal, FallbackValue=False}">
                            <Label Grid.Column="0" Text="T. Principal" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" WidthRequest="90" />
                            <Label Grid.Column="1" Text="{Binding Profile.TeamPrincipal}" FontFamily="SpaceMonoBold" FontSize="12"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12"
                              IsVisible="{Binding Profile.TechnicalDirector, FallbackValue=False}">
                            <Label Grid.Column="0" Text="Tech. Director" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" WidthRequest="90" />
                            <Label Grid.Column="1" Text="{Binding Profile.TechnicalDirector}" FontFamily="SpaceMonoBold" FontSize="12"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,6" ColumnSpacing="12"
                              IsVisible="{Binding Profile.ReserveDriver, FallbackValue=False}">
                            <Label Grid.Column="0" Text="Reserve Driver" FontFamily="SpaceMonoRegular" FontSize="12"
                                   TextColor="{StaticResource CoolSlate}" VerticalOptions="Center" WidthRequest="90" />
                            <Label Grid.Column="1" Text="{Binding Profile.ReserveDriver}" FontFamily="SpaceMonoBold" FontSize="12"
                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,10"
                                 IsVisible="{Binding Profile.History, FallbackValue=False}" />

                        <Label Text="{Binding Profile.History}" FontFamily="SpaceMonoRegular" FontSize="12"
                               TextColor="{StaticResource CoolSlate}" LineHeight="1.6"
                               IsVisible="{Binding Profile.History, FallbackValue=False}" />

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,10"
                                 IsVisible="{Binding Profile.PreviousSeasonSummary, FallbackValue=False}" />

                        <Label Text="{Binding Profile.PreviousSeasonSummary}" FontFamily="SpaceMonoRegular" FontSize="12"
                               TextColor="{StaticResource CoolSlate}" LineHeight="1.6"
                               IsVisible="{Binding Profile.PreviousSeasonSummary, FallbackValue=False}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
