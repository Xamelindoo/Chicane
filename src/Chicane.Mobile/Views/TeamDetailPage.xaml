<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamDetailPage"
             x:DataType="viewmodels:TeamDetailViewModel"
             Title="{Binding TeamName}"
             BackgroundColor="{StaticResource CarbonBlack}">

    <Grid RowDefinitions="*">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RacingRed}" HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading team..." Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="{StaticResource RacingRed}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" />
            <Button Text="RETRY" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView IsVisible="{Binding HasData}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- Team Header -->
                <Border BackgroundColor="{Binding BorderColor}"
                        StrokeThickness="0"
                        Padding="20,48,20,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="{Binding Emoji}" FontSize="24" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TeamName}"
                               FontFamily="SpaceMonoBold" FontSize="20"
                               TextColor="{StaticResource PureWhite}"
                               VerticalOptions="Center" Margin="8,0,0,0" />
                        <Label Grid.Column="2"
                               Text="{Binding TotalPoints, StringFormat='{0} pts'}"
                               FontFamily="SpaceMonoBold" FontSize="16"
                               TextColor="#FFFFFF99"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Drivers Section -->
                <Label Text="DRIVERS"
                       FontFamily="SpaceMonoBold" FontSize="12"
                       TextColor="{StaticResource PureWhite}"
                       CharacterSpacing="3"
                       Margin="20,20,20,10" />

                <CollectionView ItemsSource="{Binding Drivers}"
                                x:DataType="viewmodels:TeamDetailViewModel">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DriverEntry">
                            <Grid ColumnDefinitions="4,*"
                                  Margin="20,0,20,8">
                                <BoxView Grid.Column="0" WidthRequest="4"
                                         Color="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamDetailViewModel}}, Path=BorderColor}"
                                         VerticalOptions="Fill" />
                                <Border Grid.Column="1"
                                        Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 0,4,4,0"
                                        BackgroundColor="{StaticResource SurfaceLow}"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}"
                                               FontFamily="SpaceMonoRegular" FontSize="14"
                                               TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Points}" FontFamily="SpaceMonoBold" FontSize="14"
                                                   TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                            <Label Text="pts" FontFamily="SpaceMonoRegular" FontSize="10"
                                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Race Results Header (tappable) -->
                <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="14" Margin="20,20,20,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRaceListCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="RACE RESULTS"
                               FontFamily="SpaceMonoBold" FontSize="13"
                               TextColor="{StaticResource PureWhite}"
                               CharacterSpacing="3" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding TotalPoints}" FontFamily="SpaceMonoBold" FontSize="14"
                                   TextColor="{StaticResource RacingRed}" VerticalOptions="Center" />
                            <Label Text="pts" FontFamily="SpaceMonoRegular" FontSize="10"
                                   TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Horizontal Race Scroll -->
                <CollectionView ItemsSource="{Binding RaceResults}"
                                x:DataType="viewmodels:TeamDetailViewModel"
                                ItemsLayout="HorizontalList"
                                Margin="0,10,0,0"
                                HeightRequest="140">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TeamRaceResult">
                            <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="{StaticResource SurfaceLow}"
                                    Padding="12,10"
                                    Margin="8,0,8,0"
                                    WidthRequest="170">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamDetailViewModel}}, Path=NavigateToRaceCommand}"
                                        CommandParameter="{Binding EventName}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding EventName}"
                                           FontFamily="SpaceMonoBold" FontSize="11"
                                           TextColor="{StaticResource PureWhite}"
                                           LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="Auto,Auto">
                                        <Label Grid.Column="0" Text="{Binding TotalPoints}"
                                               FontFamily="SpaceMonoBold" FontSize="18"
                                               TextColor="{StaticResource PureWhite}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text=" pts"
                                               FontFamily="SpaceMonoRegular" FontSize="10"
                                               TextColor="{StaticResource TextMuted}"
                                               VerticalOptions="Center" Margin="2,0,0,0" />
                                    </Grid>
                                    <Label FontFamily="SpaceMonoRegular" FontSize="10"
                                           TextColor="{StaticResource CoolSlate}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1} pts">
                                                <Binding Path="Driver1Position" StringFormat="P{0}" />
                                                <Binding Path="Driver1Points" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label FontFamily="SpaceMonoRegular" FontSize="10"
                                           TextColor="{StaticResource CoolSlate}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1} pts">
                                                <Binding Path="Driver2Position" StringFormat="P{0}" />
                                                <Binding Path="Driver2Points" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
