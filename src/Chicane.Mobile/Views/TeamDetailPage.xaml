<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamDetailPage"
             x:DataType="viewmodels:TeamDetailViewModel"
             Title="{Binding TeamName}"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="*">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600" HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading team..." FontFamily="TitilliumWebRegular" FontSize="12" TextColor="#666666" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}" FontFamily="TitilliumWebSemiBold" FontSize="14" TextColor="#A0A0A0" HorizontalOptions="Center" />
            <Button Text="RETRY" BackgroundColor="#E10600" TextColor="#FFFFFF"
                    FontFamily="TitilliumWebBold" FontSize="12" CornerRadius="4" Padding="24,10"
                    Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView IsVisible="{Binding HasData}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- Gradient Banner -->
                <Border StrokeThickness="0" HeightRequest="220">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{Binding GradientColor}" Offset="0.0" />
                            <GradientStop Color="#0b1320" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Image Source="{Binding TeamLogoTransparent}"
                               HeightRequest="130"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Stats Row -->
                <Border StrokeThickness="1" Stroke="#333333"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#131313"
                        Padding="16,12" Margin="20,12,20,0">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding TotalPoints}" FontFamily="TitilliumWebBold" FontSize="22"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label Text="POINTS" FontFamily="TitilliumWebRegular" FontSize="10"
                                   TextColor="#666666" HorizontalOptions="Center" CharacterSpacing="2" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding Drivers.Count}" FontFamily="TitilliumWebBold" FontSize="22"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label Text="DRIVERS" FontFamily="TitilliumWebRegular" FontSize="10"
                                   TextColor="#666666" HorizontalOptions="Center" CharacterSpacing="2" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding RaceResults.Count}" FontFamily="TitilliumWebBold" FontSize="22"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label Text="RACES" FontFamily="TitilliumWebRegular" FontSize="10"
                                   TextColor="#666666" HorizontalOptions="Center" CharacterSpacing="2" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Drivers Section -->
                <Label Text="DRIVERS" FontFamily="TitilliumWebBold" FontSize="13"
                       TextColor="#FFFFFF" CharacterSpacing="3"
                       Margin="20,20,20,8" />
                <CollectionView ItemsSource="{Binding Drivers}"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DriverEntry">
                            <Border StrokeThickness="1" Stroke="#333333"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#131313"
                                    Padding="14,12" Margin="20,0,20,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}"
                                           FontFamily="TitilliumWebRegular" FontSize="15"
                                           TextColor="#FFFFFF" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding Points}" FontFamily="TitilliumWebBold" FontSize="16"
                                               TextColor="#E10600" VerticalOptions="Center" />
                                        <Label Text="pts" FontFamily="TitilliumWebRegular" FontSize="11"
                                               TextColor="#666666" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Race Results Header -->
                <Border StrokeThickness="1" Stroke="#333333"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#131313"
                        Padding="14" Margin="20,20,20,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRaceListCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="RACE RESULTS"
                               FontFamily="TitilliumWebBold" FontSize="13"
                               TextColor="#FFFFFF" CharacterSpacing="3" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding TotalPoints}" FontFamily="TitilliumWebBold" FontSize="14"
                                   TextColor="#E10600" VerticalOptions="Center" />
                            <Label Text="pts" FontFamily="TitilliumWebRegular" FontSize="10"
                                   TextColor="#666666" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Race Results Horizontal Scroll -->
                <ScrollView Orientation="Horizontal" Margin="20,8,20,0" HeightRequest="158"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding RaceResults}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TeamRaceResult">
                                <Border StrokeThickness="1" Stroke="#333333"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#131313"
                                        Padding="12,10" WidthRequest="180">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamDetailViewModel}}, Path=NavigateToRaceCommand}"
                                            CommandParameter="{Binding EventName}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding EventName}" FontFamily="TitilliumWebBold" FontSize="12"
                                               TextColor="#FFFFFF" LineBreakMode="TailTruncation" />
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                            <Label Grid.Column="0" Text="{Binding TotalPoints}"
                                                   FontFamily="TitilliumWebBold" FontSize="20"
                                                   TextColor="#E10600" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="pts" FontFamily="TitilliumWebRegular"
                                                   FontSize="11" TextColor="#666666" VerticalOptions="Center" />
                                        </Grid>
                                        <Label FontFamily="TitilliumWebRegular" FontSize="10" TextColor="#A0A0A0">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} P{1} · {2} P{3}">
                                                    <Binding Path="Driver1Name" />
                                                    <Binding Path="Driver1Position" />
                                                    <Binding Path="Driver2Name" />
                                                    <Binding Path="Driver2Position" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Label Text="{Binding EventDate, StringFormat='{0:dd MMM yyyy}'}"
                                               FontFamily="TitilliumWebRegular" FontSize="10"
                                               TextColor="#A0A0A0" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Profile Info Section -->
                <Label Text="TEAM INFO" FontFamily="TitilliumWebBold" FontSize="13"
                       TextColor="#FFFFFF" CharacterSpacing="3"
                       Margin="20,20,20,8" />

                <Border StrokeThickness="1" Stroke="#333333"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#131313"
                        Padding="16,14" Margin="20,0,20,0">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="12" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="CHASSIS" FontSize="9" TextColor="#666666"
                                   FontFamily="TitilliumWebBold" CharacterSpacing="2" />
                            <Label Text="{Binding Profile.Chassis, FallbackValue='—'}"
                                   FontFamily="TitilliumWebRegular" FontSize="13" TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label Text="POWER UNIT" FontSize="9" TextColor="#666666"
                                   FontFamily="TitilliumWebBold" CharacterSpacing="2" />
                            <Label Text="{Binding Profile.PowerUnit, FallbackValue='—'}"
                                   FontFamily="TitilliumWebRegular" FontSize="13" TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="BASE" FontSize="9" TextColor="#666666"
                                   FontFamily="TitilliumWebBold" CharacterSpacing="2" />
                            <Label Text="{Binding Profile.Base, FallbackValue='—'}"
                                   FontFamily="TitilliumWebRegular" FontSize="13" TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="PRINCIPAL" FontSize="9" TextColor="#666666"
                                   FontFamily="TitilliumWebBold" CharacterSpacing="2" />
                            <Label Text="{Binding Profile.TeamPrincipal, FallbackValue='—'}"
                                   FontFamily="TitilliumWebRegular" FontSize="13" TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                            <Label Text="FULL NAME" FontSize="9" TextColor="#666666"
                                   FontFamily="TitilliumWebBold" CharacterSpacing="2" />
                            <Label Text="{Binding Profile.FullName, FallbackValue='—'}"
                                   FontFamily="TitilliumWebRegular" FontSize="13" TextColor="#FFFFFF" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
