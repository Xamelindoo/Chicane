<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.CategorySwitcher"
             x:DataType="viewmodels:CategorySwitcherViewModel">

    <FlexLayout Direction="Row"
                JustifyContent="Center"
                AlignItems="Center"
                Wrap="NoWrap">

        <BindableLayout.ItemsSource>
            <Binding Path="Categories" />
        </BindableLayout.ItemsSource>

        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:MotorsportCategory">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 4"
                        Padding="14,8"
                        Margin="4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectedId}"
                                             Value="{Binding Id}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLow}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectCategoryCommand}"
                            CommandParameter="{Binding Id}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Emoji}" FontSize="20" HorizontalOptions="Center" />
                        <Label Text="{Binding Name}"
                               FontFamily="SpaceMonoBold"
                               FontSize="10"
                               HorizontalOptions="Center">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectedId}"
                                                     Value="{Binding Id}">
                                            <Setter Property="TextColor" Value="{StaticResource RacingRed}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>

</ContentView>
