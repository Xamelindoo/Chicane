<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.CategorySwitcher"
             x:DataType="viewmodels:CategorySwitcherViewModel"
             InputTransparent="False">

    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">

        <!-- Tap Target: selected category (fixed width) -->
        <Border Stroke="{StaticResource PureWhite}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 4"
                BackgroundColor="#20FFFFFF"
                Padding="16,6"
                WidthRequest="170">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="{Binding SelectedEmoji}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Label Text="{Binding SelectedName}"
                       FontFamily="SpaceMonoBold"
                       FontSize="12"
                       TextColor="{StaticResource PureWhite}"
                       VerticalOptions="Center" />
                <Label Text="▼"
                       FontSize="9"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Dropdown (overlay below trigger, absolute positioned) -->
        <Border IsVisible="{Binding IsMenuOpen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#F00A0A0A"
                Padding="12"
                Margin="0,6,0,0"
                WidthRequest="200">
            <VerticalStackLayout Spacing="0">
                <CollectionView ItemsSource="{Binding Categories}"
                                x:DataType="viewmodels:CategorySwitcherViewModel"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MotorsportCategory">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="12,10"
                                    Margin="0,2"
                                    HorizontalOptions="Start">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectedId}"
                                                         Value="{Binding Id}">
                                                <Setter Property="BackgroundColor" Value="#30FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectCategoryCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding Emoji}"
                                           FontSize="16" VerticalOptions="Center"
                                           HorizontalOptions="Start" />
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontFamily="SpaceMonoBold" FontSize="13"
                                           VerticalOptions="Center">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectedId}"
                                                                 Value="{Binding Id}">
                                                        <Setter Property="TextColor" Value="{Binding AccentColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                    <Border Grid.Column="2" WidthRequest="12" HeightRequest="12"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="{Binding AccentColor}" />
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentView>
