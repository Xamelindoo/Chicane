<?xml version="1.0" encoding="utf-8" ?>
<!-- ROOT: fixed, full-screen, pointer-events: none (pass through when closed) -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.CategorySwitcher"
             x:DataType="viewmodels:CategorySwitcherViewModel"
             InputTransparent="True"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid>

        <!-- BACKDROP: visible only when menu open; pointer-events: auto -->
        <BoxView IsVisible="{Binding IsMenuOpen}"
                 Color="#66000000"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMenuCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- PILL: position absolute top center; pointer-events: auto; z-index 10 -->
        <Label VerticalOptions="Start"
               HorizontalOptions="Center"
               Padding="0,52,0,0"
               InputTransparent="False">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Label.GestureRecognizers>
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{Binding SelectedEmoji}" FontSize="14" />
                    <Span Text=" " />
                    <Span Text="{Binding SelectedName}" FontFamily="SpaceMonoBold" FontSize="12"
                          TextColor="{StaticResource PureWhite}" />
                    <Span Text=" " />
                    <Span Text="{Binding ArrowIndicator}" FontSize="9"
                          TextColor="{StaticResource TextMuted}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- DROPDOWN: visible only when menu open; pointer-events: auto; z-index 10 -->
        <Border IsVisible="{Binding IsMenuOpen}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#F20A0A0A"
                Padding="10"
                WidthRequest="220"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="0,88,0,0"
                InputTransparent="False">
            <VerticalStackLayout Spacing="0">
                <CollectionView ItemsSource="{Binding Categories}"
                                x:DataType="viewmodels:CategorySwitcherViewModel"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MotorsportCategory">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="12,10"
                                    Margin="0,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectedId}"
                                                         Value="{Binding Id}">
                                                <Setter Property="BackgroundColor" Value="#25FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectCategoryCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding Emoji}"
                                           FontSize="16" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontFamily="SpaceMonoBold" FontSize="13"
                                           VerticalOptions="Center">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategorySwitcherViewModel}}, Path=SelectedId}"
                                                                 Value="{Binding Id}">
                                                        <Setter Property="TextColor" Value="{Binding AccentColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                    <Border Grid.Column="2" WidthRequest="12" HeightRequest="12"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="{Binding AccentColor}" />
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
