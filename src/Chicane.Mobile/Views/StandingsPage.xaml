<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             x:Class="Chicane.Mobile.Views.StandingsPage"
             x:DataType="viewmodels:StandingsViewModel"
             Title="Standings">

    <Grid RowDefinitions="*" BackgroundColor="{StaticResource CarbonBlack}">
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="16">

            <Border Style="{StaticResource PlaceholderCard}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Standings"
                        Style="{StaticResource Headline}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Driver and constructor standings will appear here."
                        Style="{StaticResource Caption}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
