<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamRaceListPage"
             x:DataType="viewmodels:TeamRaceListViewModel"
             Title="Race Results"
             BackgroundColor="{StaticResource CarbonBlack}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Stroke="{StaticResource BorderSubtle}" StrokeThickness="0"
                BackgroundColor="{StaticResource SurfaceLow}"
                Padding="20,48,20,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="RACE RESULTS"
                       FontFamily="TitilliumWebBold" FontSize="14"
                       TextColor="{StaticResource PureWhite}"
                       CharacterSpacing="4" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="{Binding TotalPoints}" FontFamily="TitilliumWebBold" FontSize="16"
                           TextColor="{StaticResource RacingRed}" VerticalOptions="Center" />
                    <Label Text="pts" FontFamily="TitilliumWebRegular" FontSize="11"
                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource RacingRed}" HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading results..." Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasError}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="{StaticResource RacingRed}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource SubHeadline}" HorizontalOptions="Center" />
            <Button Text="RETRY" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Race List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding RaceResults}"
                        IsVisible="{Binding HasData}"
                        x:DataType="viewmodels:TeamRaceListViewModel"
                        Margin="0,0,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TeamRaceResult">
                    <Border Stroke="{StaticResource BorderSubtle}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{StaticResource SurfaceLow}"
                            Padding="16"
                            Margin="20,0,20,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamRaceListViewModel}}, Path=NavigateToRaceCommand}"
                                CommandParameter="{Binding EventName}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">

                            <!-- Race Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding EventName}"
                                       FontFamily="TitilliumWebBold" FontSize="15"
                                       TextColor="{StaticResource PureWhite}" />
                                <Label Grid.Column="1" Text="{Binding EventDate, StringFormat='{0:dd MMM}'}"
                                       FontFamily="TitilliumWebRegular" FontSize="11"
                                       TextColor="{StaticResource TextMuted}"
                                       VerticalOptions="End" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                            <!-- Driver 1 result -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource RacingRed}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                        Padding="6,2" VerticalOptions="Center">
                                    <Label Text="{Binding Driver1Position, StringFormat='P{0}'}"
                                           FontFamily="TitilliumWebBold" FontSize="11"
                                           TextColor="{StaticResource PureWhite}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Driver1Name}"
                                       FontFamily="TitilliumWebRegular" FontSize="13"
                                       TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Driver1Points}"
                                       FontFamily="TitilliumWebBold" FontSize="14"
                                       TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="pts"
                                       FontFamily="TitilliumWebRegular" FontSize="10"
                                       TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            </Grid>

                            <!-- Driver 2 result -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource SurfaceHigh}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                        Padding="6,2" VerticalOptions="Center">
                                    <Label Text="{Binding Driver2Position, StringFormat='P{0}'}"
                                           FontFamily="TitilliumWebBold" FontSize="11"
                                           TextColor="{StaticResource CoolSlate}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Driver2Name}"
                                       FontFamily="TitilliumWebRegular" FontSize="13"
                                       TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Driver2Points}"
                                       FontFamily="TitilliumWebBold" FontSize="14"
                                       TextColor="{StaticResource PureWhite}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="pts"
                                       FontFamily="TitilliumWebRegular" FontSize="10"
                                       TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                            <!-- Best Lap + Total -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" FontFamily="TitilliumWebRegular"
                                       FontSize="11" TextColor="{StaticResource CoolSlate}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}Best lap: {0}">
                                            <Binding Path="Driver1BestLap" FallbackValue="--:--" TargetNullValue="--:--" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <HorizontalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding TotalPoints}"
                                           FontFamily="TitilliumWebBold" FontSize="14"
                                           TextColor="{StaticResource RacingRed}" VerticalOptions="Center" />
                                    <Label Text="pts"
                                           FontFamily="TitilliumWebRegular" FontSize="10"
                                           TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
