<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamRaceListPage"
             x:DataType="viewmodels:TeamRaceListViewModel"
             Title="Race Results"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16,20,10" ColumnDefinitions="*,Auto"
              BackgroundColor="#0f172a">
            <Label Grid.Column="0" Text="RACE RESULTS"
                   FontFamily="TitilliumWebBold" FontSize="14"
                   TextColor="#FFFFFF" CharacterSpacing="4" VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="{Binding TotalPoints}" FontFamily="TitilliumWebBold" FontSize="16"
                       TextColor="#E10600" VerticalOptions="Center" />
                <Label Text="pts" FontFamily="TitilliumWebRegular" FontSize="11"
                       TextColor="#9CA3AF" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600" HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading results..." FontFamily="TitilliumWebRegular" FontSize="12"
                   TextColor="#666666" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasError}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}" FontFamily="TitilliumWebSemiBold" FontSize="14"
                   TextColor="#A0A0A0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="RETRY" BackgroundColor="#E10600" TextColor="#FFFFFF"
                    FontFamily="TitilliumWebBold" FontSize="12" CornerRadius="4" Padding="24,10"
                    Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Race List -->
        <CollectionView Grid.Row="1" VerticalScrollBarVisibility="Never"
                        ItemsSource="{Binding RaceResults}" IsVisible="{Binding HasData}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TeamRaceResult">
                    <Border StrokeThickness="1" Stroke="#2a3441" StrokeShape="RoundRectangle 10"
                            BackgroundColor="#1e293b" Padding="16" Margin="16,0,16,8">

                        <VerticalStackLayout Spacing="10">

                            <!-- Race Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding EventName}"
                                       FontFamily="TitilliumWebBold" FontSize="15"
                                       TextColor="#FFFFFF" />
                                <Label Grid.Column="1" Text="{Binding EventDate, StringFormat='{0:dd MMM}'}"
                                       FontFamily="TitilliumWebRegular" FontSize="12"
                                       TextColor="#9CA3AF" VerticalOptions="End" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#2a3441" />

                            <!-- Driver 1 result -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                        Padding="6,2" VerticalOptions="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#90111d" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Driver1Position}" Value="1">
                                                    <Setter Property="BackgroundColor" Value="#FFD700" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Driver1Position}" Value="2">
                                                    <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Driver1Position}" Value="3">
                                                    <Setter Property="BackgroundColor" Value="#CD7F32" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Label Text="{Binding Driver1Position, StringFormat='P{0}'}"
                                           FontFamily="TitilliumWebBold" FontSize="11"
                                           TextColor="#FFFFFF" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Driver1Code}"
                                       FontFamily="TitilliumWebRegular" FontSize="13"
                                       TextColor="#FFFFFF" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Driver1Points}"
                                       FontFamily="TitilliumWebBold" FontSize="14"
                                       TextColor="#FFFFFF" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="pts"
                                       FontFamily="TitilliumWebRegular" FontSize="10"
                                       TextColor="#9CA3AF" VerticalOptions="Center" />
                            </Grid>

                            <!-- Driver 2 result -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                        Padding="6,2" VerticalOptions="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#90111d" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Driver2Position}" Value="1">
                                                    <Setter Property="BackgroundColor" Value="#FFD700" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Driver2Position}" Value="2">
                                                    <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Driver2Position}" Value="3">
                                                    <Setter Property="BackgroundColor" Value="#CD7F32" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Label Text="{Binding Driver2Position, StringFormat='P{0}'}"
                                           FontFamily="TitilliumWebBold" FontSize="11"
                                           TextColor="#FFFFFF" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Driver2Code}"
                                       FontFamily="TitilliumWebRegular" FontSize="13"
                                       TextColor="#FFFFFF" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Driver2Points}"
                                       FontFamily="TitilliumWebBold" FontSize="14"
                                       TextColor="#FFFFFF" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="pts"
                                       FontFamily="TitilliumWebRegular" FontSize="10"
                                       TextColor="#9CA3AF" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#2a3441" />

                            <!-- Best Lap + Total -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" FontFamily="TitilliumWebRegular"
                                       FontSize="11" TextColor="#9CA3AF">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}Best lap: {0}">
                                            <Binding Path="Driver1BestLap" FallbackValue="--:--" TargetNullValue="--:--" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <HorizontalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding TotalPoints}"
                                           FontFamily="TitilliumWebBold" FontSize="14"
                                           TextColor="#E10600" VerticalOptions="Center" />
                                    <Label Text="pts"
                                           FontFamily="TitilliumWebRegular" FontSize="10"
                                           TextColor="#9CA3AF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
