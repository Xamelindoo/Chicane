<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.MeetingDetailPage"
             x:DataType="viewmodels:MeetingDetailViewModel"
             Title="{Binding MeetingName}"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="*">

        <!-- Session List -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Sessions}"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SessionTime">
                    <Border StrokeThickness="1" Stroke="#2a3441"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#1e293b"
                            Padding="14,12" Margin="16,0,16,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MeetingDetailViewModel}}, Path=NavigateToSessionCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding SessionName}"
                                       FontFamily="TitilliumWebBold" FontSize="14"
                                       TextColor="White" />
                                <Label Text="{Binding DateTime, StringFormat='{0:dd MMM yyyy · HH:mm}'}"
                                       FontFamily="TitilliumWebRegular" FontSize="11"
                                       TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="#10B981" Padding="8,3"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsPast}">
                                <Label Text="DONE" FontFamily="TitilliumWebBold" FontSize="9"
                                       TextColor="White" CharacterSpacing="2" />
                            </Border>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="#9CA3AF" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
