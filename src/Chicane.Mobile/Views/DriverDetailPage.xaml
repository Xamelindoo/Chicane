<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.DriverDetailPage"
             x:DataType="viewmodels:DriverDetailViewModel"
             Title="{Binding BroadcastName}"
             BackgroundColor="{StaticResource CarbonBlack}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header Gradient -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                HeightRequest="180">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{Binding TeamColour}" Offset="0.0" />
                    <GradientStop Color="{StaticResource CarbonBlack}" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Driver Info -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="6"
                             Padding="20,0"
                             Margin="0,-80,0,0">
            <!-- Headshot -->
            <Border Stroke="{StaticResource BorderSubtle}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 40"
                    HeightRequest="80"
                    WidthRequest="80"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource SurfaceLow}">
                <Image Source="{Binding HeadshotUrl}"
                       Aspect="AspectFill" />
            </Border>

            <Label Text="{Binding BroadcastName}"
                   FontFamily="TitilliumWebBold" FontSize="24"
                   TextColor="{StaticResource PureWhite}"
                   HorizontalOptions="Center" />

            <Label Text="{Binding FullName}"
                   FontFamily="TitilliumWebRegular" FontSize="13"
                   TextColor="{StaticResource CoolSlate}"
                   HorizontalOptions="Center" />

            <!-- Team Pill -->
            <Border StrokeThickness="0"
                    BackgroundColor="{StaticResource SurfaceLow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="14,6"
                    HorizontalOptions="Center"
                    Margin="0,6,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToTeamCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="12" HeightRequest="12"
                             CornerRadius="6"
                             Color="{Binding TeamColour}"
                             VerticalOptions="Center" />
                    <Label Text="{Binding TeamName}"
                           FontFamily="TitilliumWebSemiBold" FontSize="13"
                           TextColor="{StaticResource PureWhite}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Stats Row -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8"
                  Margin="0,10,0,0">
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        StrokeShape="RoundRectangle 6"
                        Padding="10,8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding Position, StringFormat='#{0}'}"
                               FontFamily="TitilliumWebBold" FontSize="18"
                               TextColor="{StaticResource RacingRed}"
                               HorizontalOptions="Center" />
                        <Label Text="Position"
                               FontFamily="TitilliumWebRegular" FontSize="10"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        StrokeShape="RoundRectangle 6"
                        Padding="10,8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding TotalPoints}"
                               FontFamily="TitilliumWebBold" FontSize="18"
                               TextColor="{StaticResource RacingRed}"
                               HorizontalOptions="Center" />
                        <Label Text="Points"
                               FontFamily="TitilliumWebRegular" FontSize="10"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        StrokeShape="RoundRectangle 6"
                        Padding="10,8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding NameAcronym}"
                               FontFamily="TitilliumWebBold" FontSize="18"
                               TextColor="{StaticResource PureWhite}"
                               HorizontalOptions="Center" />
                        <Label Text="Acronym"
                               FontFamily="TitilliumWebRegular" FontSize="10"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Race Results Header -->
            <Label Text="RACE RESULTS"
                   FontFamily="TitilliumWebBold"
                   FontSize="11"
                   TextColor="{StaticResource TextMuted}"
                   CharacterSpacing="3"
                   Margin="0,16,0,4" />

            <!-- Empty State -->
            <Label Text="No race results yet"
                   FontFamily="TitilliumWebRegular"
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsEmptyState}" />
        </VerticalStackLayout>

        <!-- Race Results List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding RaceResults}"
                        Margin="0,8,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DriverRaceResult">
                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{StaticResource SurfaceLow}"
                            Padding="14"
                            Margin="20,0,20,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DriverDetailViewModel}}, Path=NavigateToRaceCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="32,*,Auto"
                              ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{Binding Position, StringFormat='P{0}'}"
                                   FontFamily="TitilliumWebBold"
                                   FontSize="13"
                                   TextColor="{StaticResource RacingRed}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="1">
                                <Label Text="{Binding SessionName}"
                                       FontFamily="TitilliumWebRegular"
                                       FontSize="12"
                                       TextColor="{StaticResource PureWhite}" />
                                <Label Text="{Binding CircuitName}"
                                       FontSize="10"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding EventDate, StringFormat='{0:dd MMM}'}"
                                   FontFamily="TitilliumWebRegular"
                                   FontSize="11"
                                   TextColor="{StaticResource CoolSlate}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource RacingRed}" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}"
                   FontFamily="TitilliumWebRegular"
                   FontSize="14"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center" />
            <Button Text="Retry"
                    Command="{Binding LoadCommand}"
                    BackgroundColor="{StaticResource RacingRed}"
                    TextColor="{StaticResource PureWhite}"
                    FontFamily="TitilliumWebBold"
                    CornerRadius="4"
                    Padding="20,8"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
