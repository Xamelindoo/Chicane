<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.LeaderboardsPage"
             x:DataType="viewmodels:LeaderboardsViewModel"
             Title="Leaderboards"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Compact Header -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="20,12,20,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#111827" Offset="0" />
                    <GradientStop Color="#1e1b4b" Offset="0.5" />
                    <GradientStop Color="#4c1d95" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="&#x1F3C1;" FontSize="14" VerticalOptions="Center" />
                <Label Text="CHICANE" FontFamily="OutfitBold" FontSize="20"
                       FontAttributes="Italic" TextColor="White" VerticalOptions="Center"
                       CharacterSpacing="2" />
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,0" Opacity="0.5">
                <Label Text="Season" FontFamily="TitilliumWebRegular"
                       FontSize="10" TextColor="#9CA3AF" VerticalOptions="Center" />
                <Picker ItemsSource="{Binding AvailableYears}"
                        SelectedItem="{Binding SelectedYear}"
                        FontFamily="TitilliumWebBold" FontSize="11"
                        TextColor="White" VerticalOptions="Center"
                        BackgroundColor="Transparent" WidthRequest="80" />
            </HorizontalStackLayout>
        </Border>

        <!-- Toggle Pilots / Teams -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="20,10,20,6" ColumnSpacing="0"
              BackgroundColor="#0f172a">
            <Border Grid.Column="0" StrokeThickness="1" Stroke="#E10600"
                    StrokeShape="RoundRectangle 4,0,0,4" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BackgroundColor" Value="#1e293b" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsShowingPilots}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E10600" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowPilotsCommand}" />
                </Border.GestureRecognizers>
                <Label Text="PILOTI" FontFamily="TitilliumWebBold" FontSize="11"
                       VerticalOptions="Center" HorizontalOptions="Center"
                       CharacterSpacing="3" Padding="0,9" TextColor="#9CA3AF">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsShowingPilots}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
            <Border Grid.Column="1" StrokeThickness="1" Stroke="#E10600"
                    StrokeShape="RoundRectangle 0,4,4,0" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BackgroundColor" Value="#1e293b" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsShowingTeams}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E10600" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowTeamsCommand}" />
                </Border.GestureRecognizers>
                <Label Text="TEAM" FontFamily="TitilliumWebBold" FontSize="11"
                       VerticalOptions="Center" HorizontalOptions="Center"
                       CharacterSpacing="3" Padding="0,9" TextColor="#9CA3AF">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsShowingTeams}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsBusy}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600" HeightRequest="40" WidthRequest="40" />
            <Label Text="Loading..." FontFamily="TitilliumWebRegular" FontSize="12"
                   TextColor="#9CA3AF" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding HasError}"
                              VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}" FontFamily="TitilliumWebBold" FontSize="14"
                   TextColor="#9CA3AF" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="RETRY" Command="{Binding LoadCommand}"
                    BackgroundColor="#E10600" TextColor="White" FontFamily="TitilliumWebBold"
                    FontSize="12" CornerRadius="4" Padding="24,10" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Driver & Team Standings -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <Grid>
        <CollectionView ItemsSource="{Binding Drivers}"
                        IsVisible="{Binding IsShowingPilots}" Margin="0,0,0,0"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DriverStandingsEntry">
                    <Border StrokeThickness="1" Stroke="#2a3441" StrokeShape="RoundRectangle 10"
                            BackgroundColor="#1e293b" Padding="14,12" Margin="16,0,16,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LeaderboardsViewModel}}, Path=NavigateToDriverCommand}"
                                CommandParameter="{Binding DriverNumber}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="32,42,*,Auto,Auto" ColumnSpacing="10">
                            <!-- Position -->
                            <Label Grid.Column="0" Text="{Binding Position, StringFormat='{0}'}"
                                   FontFamily="TitilliumWebBold" FontSize="17"
                                   VerticalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="1">
                                        <Setter Property="TextColor" Value="#FCD34D" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="2">
                                        <Setter Property="TextColor" Value="#E2E8F0" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="3">
                                        <Setter Property="TextColor" Value="#F87171" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <!-- Headshot -->
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#2a3441"
                                    StrokeShape="RoundRectangle 21" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#0f172a">
                                <Image Source="{Binding HeadshotUrl}" Aspect="AspectFill" />
                            </Border>
                            <!-- Name + Team -->
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding DriverName}" FontFamily="TitilliumWebRegular"
                                       FontSize="15" TextColor="White" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding TeamName}" FontSize="11" TextColor="#9CA3AF"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <!-- Position Change Arrow -->
                            <Label Grid.Column="3" Text="{Binding PositionArrow}"
                                   TextColor="{Binding PositionArrowColor}"
                                   FontFamily="TitilliumWebBold" FontSize="15"
                                   VerticalOptions="Center" HorizontalTextAlignment="Center"
                                   WidthRequest="24" />
                            <!-- Points -->
                            <Label Grid.Column="4" Text="{Binding Points}" FontFamily="TitilliumWebBold"
                                   FontSize="17" TextColor="White" VerticalOptions="Center"
                                   HorizontalTextAlignment="End" WidthRequest="50" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Team Standings List -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Teams}"
                        IsVisible="{Binding IsShowingTeams}" Margin="0,0,0,0"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TeamEntry">
                    <Border StrokeThickness="1" Stroke="#2a3441" StrokeShape="RoundRectangle 10"
                            BackgroundColor="#1e293b" Padding="14,12" Margin="16,0,16,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LeaderboardsViewModel}}, Path=NavigateToDetailCommand}"
                                CommandParameter="{Binding TeamName}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="32,42,*,Auto" ColumnSpacing="10">
                            <!-- Position -->
                            <Label Grid.Column="0" Text="{Binding Position, StringFormat='{0}'}"
                                   FontFamily="TitilliumWebBold" FontSize="17"
                                   VerticalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="1">
                                        <Setter Property="TextColor" Value="#FCD34D" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="2">
                                        <Setter Property="TextColor" Value="#E2E8F0" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="3">
                                        <Setter Property="TextColor" Value="#F87171" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <!-- Team Logo -->
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#2a3441"
                                    StrokeShape="RoundRectangle 21" WidthRequest="42" HeightRequest="42"
                                    BackgroundColor="#0f172a" Padding="2">
                                <Image Source="{Binding TeamLogo}" Aspect="AspectFit" />
                            </Border>
                            <!-- Team Name -->
                            <Label Grid.Column="2" Text="{Binding TeamName}" FontFamily="TitilliumWebRegular"
                                   FontSize="15" TextColor="White" VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />
                            <!-- Points -->
                            <Label Grid.Column="3" Text="{Binding Points}" FontFamily="TitilliumWebBold"
                                   FontSize="16" TextColor="White" VerticalOptions="Center"
                                   HorizontalTextAlignment="End" WidthRequest="50" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
        </RefreshView>

    </Grid>

</ContentPage>
