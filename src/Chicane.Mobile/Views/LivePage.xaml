<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.LivePage"
             x:DataType="viewmodels:LiveViewModel"
             Title="LIVE"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="*">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600" HeightRequest="48" WidthRequest="48" />
            <Label Text="Connecting to live session..."
                   FontFamily="TitilliumWebRegular" FontSize="12"
                   TextColor="#666666" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}"
                   FontFamily="TitilliumWebSemiBold" FontSize="14"
                   TextColor="#A0A0A0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="RETRY" BackgroundColor="#E10600" TextColor="#FFFFFF"
                    FontFamily="TitilliumWebBold" FontSize="12" CornerRadius="4" Padding="24,10"
                    Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <RefreshView IsVisible="{Binding HasData}"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                    <!-- LIVE Banner -->
                    <Border StrokeThickness="0" BackgroundColor="#E10600"
                            Padding="16,10">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="LIVE"
                                   FontFamily="TitilliumWebBold" FontSize="14"
                                   TextColor="White" CharacterSpacing="6"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding MeetingName}"
                                   FontFamily="TitilliumWebBold" FontSize="18"
                                   TextColor="White" HorizontalOptions="Center"
                                   CharacterSpacing="2" />
                            <Label Text="{Binding SessionName}"
                                   FontFamily="TitilliumWebRegular" FontSize="12"
                                   TextColor="#FFCCCC" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lap Counter -->
                    <Border StrokeThickness="0" BackgroundColor="#1e293b"
                            Padding="20,10" Margin="0,0,0,0">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Border StrokeThickness="0" BackgroundColor="#E10600"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="24,10" HorizontalOptions="Center">
                                <Label Text="{Binding LapsDisplay}"
                                       FontFamily="SpaceMonoBold" FontSize="36"
                                       TextColor="White" HorizontalOptions="Center" />
                            </Border>
                            <Label Text="LAPS" FontFamily="TitilliumWebRegular" FontSize="11"
                                   TextColor="#9CA3AF" HorizontalOptions="Center"
                                   CharacterSpacing="3" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Track Map -->
                    <Grid HeightRequest="180" Margin="16,8,16,0">
                        <!-- Circuit image background -->
                        <Image Source="{Binding CircuitImageUrl}"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <!-- Driver dots overlay -->
                        <GraphicsView x:Name="TrackGraphics"
                                      Drawable="{Binding TrackDrawable}"
                                      BackgroundColor="Transparent"
                                      HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </Grid>

                    <!-- Positions -->
                    <Label Text="POSITIONS" FontFamily="TitilliumWebBold" FontSize="13"
                           TextColor="#FFFFFF" CharacterSpacing="3"
                           Margin="20,16,20,8" />

                    <CollectionView ItemsSource="{Binding VisiblePositions}"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LiveDriverRow">
                                <Border StrokeThickness="1" Stroke="#2a3441"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#1e293b"
                                        Padding="14,12" Margin="16,0,16,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LiveViewModel}}, Path=ToggleDriverCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <!-- Row 1: badge + name + gap -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="7,3" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#90111d" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Position}" Value="1">
                                                                <Setter Property="BackgroundColor" Value="#FFD700" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Position}" Value="2">
                                                                <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Position}" Value="3">
                                                                <Setter Property="BackgroundColor" Value="#CD7F32" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="{Binding Position, StringFormat='P{0}'}"
                                                       FontFamily="TitilliumWebBold" FontSize="12"
                                                       TextColor="#FFFFFF" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Text="{Binding DriverDisplay}"
                                                   FontFamily="TitilliumWebBold" FontSize="15"
                                                   TextColor="White" VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding GapDisplay}"
                                                   FontFamily="TitilliumWebBold" FontSize="14"
                                                   TextColor="#E10600" VerticalOptions="Center"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                        <!-- Row 2: team + interval -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <!-- spacer below badge -->
                                            <BoxView Grid.Column="0" Color="Transparent" WidthRequest="42" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding TeamName}"
                                                   FontFamily="TitilliumWebRegular" FontSize="11"
                                                   TextColor="#9CA3AF" VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding IntervalDisplay}"
                                                   FontFamily="TitilliumWebRegular" FontSize="11"
                                                   TextColor="#9CA3AF" VerticalOptions="Center"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>

                                        <!-- Expanded telemetry -->
                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="6">
                                            <BoxView HeightRequest="1" Color="#2a3441" />
                                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
                                                  RowSpacing="6" ColumnSpacing="10">
                                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="1">
                                                    <Label Text="SPEED" FontFamily="TitilliumWebRegular" FontSize="9"
                                                           TextColor="#9CA3AF" CharacterSpacing="2" />
                                                    <Label Text="{Binding Speed, StringFormat='{0} km/h'}"
                                                           FontFamily="TitilliumWebBold" FontSize="16" TextColor="White" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="1">
                                                    <Label Text="RPM" FontFamily="TitilliumWebRegular" FontSize="9"
                                                           TextColor="#9CA3AF" CharacterSpacing="2" />
                                                    <Label Text="{Binding Rpm}" FontFamily="TitilliumWebBold"
                                                           FontSize="16" TextColor="White" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="1">
                                                    <Label Text="GEAR" FontFamily="TitilliumWebRegular" FontSize="9"
                                                           TextColor="#9CA3AF" CharacterSpacing="2" />
                                                    <Label Text="{Binding Gear}" FontFamily="TitilliumWebBold"
                                                           FontSize="16" TextColor="White" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="1">
                                                    <Label Text="DRS" FontFamily="TitilliumWebRegular" FontSize="9"
                                                           TextColor="#9CA3AF" CharacterSpacing="2" />
                                                    <Label Text="{Binding DrsStatus}" FontFamily="TitilliumWebBold"
                                                           FontSize="16" TextColor="#10B981" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                                    <HorizontalStackLayout Spacing="16">
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="Throttle" FontFamily="TitilliumWebRegular"
                                                                   FontSize="11" TextColor="#9CA3AF" />
                                                            <Label Text="{Binding Throttle, StringFormat='{0}%'}"
                                                                   FontFamily="TitilliumWebBold" FontSize="12"
                                                                   TextColor="#10B981" />
                                                        </HorizontalStackLayout>
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="Brake" FontFamily="TitilliumWebRegular"
                                                                   FontSize="11" TextColor="#9CA3AF" />
                                                            <Label Text="{Binding Brake, StringFormat='{0}%'}"
                                                                   FontFamily="TitilliumWebBold" FontSize="12"
                                                                   TextColor="#EF4444" />
                                                        </HorizontalStackLayout>
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="Pit" FontFamily="TitilliumWebRegular"
                                                                   FontSize="11" TextColor="#9CA3AF" />
                                                            <Label Text="{Binding LastPit}"
                                                                   FontFamily="TitilliumWebBold" FontSize="12"
                                                                   TextColor="White" />
                                                        </HorizontalStackLayout>
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="Tyre" FontFamily="TitilliumWebRegular"
                                                                   FontSize="11" TextColor="#9CA3AF" />
                                                            <Label Text="{Binding TyreCompound}"
                                                                   FontFamily="TitilliumWebBold" FontSize="12"
                                                                   TextColor="White" />
                                                        </HorizontalStackLayout>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Show All button -->
                    <Border StrokeThickness="1" Stroke="#2a3441"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#1e293b"
                            Padding="12,8" Margin="16,8,16,0"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleShowAllCommand}" />
                        </Border.GestureRecognizers>
                        <Label FontFamily="TitilliumWebBold" FontSize="12"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ShowAllDrivers}" Value="True">
                                    <Setter Property="Text" Value="SHOW TOP 5 &#x25B2;" />
                                    <Setter Property="TextColor" Value="#9CA3AF" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ShowAllDrivers}" Value="False">
                                    <Setter Property="Text" Value="SHOW ALL 22 &#x25BE;" />
                                    <Setter Property="TextColor" Value="#9CA3AF" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Commentary -->
                    <ScrollView Orientation="Horizontal" Margin="16,8,16,0"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10"
                                               BindableLayout.ItemsSource="{Binding Commentary}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:LiveCommentaryItem">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding Icon}" FontSize="13"
                                               VerticalOptions="Center" />
                                        <Label FontFamily="TitilliumWebRegular" FontSize="11"
                                               TextColor="White" VerticalOptions="Center"
                                               LineBreakMode="NoWrap">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Message" />
                                                    <Binding Path="LapInfo" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>
