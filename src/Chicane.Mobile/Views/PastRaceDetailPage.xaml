<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.PastRaceDetailPage"
             x:DataType="viewmodels:PastRaceDetailViewModel"
             Title="Race Results"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="*">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600"
                               HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading results..." FontFamily="TitilliumWebRegular" FontSize="12"
                   TextColor="#666666" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}" FontFamily="TitilliumWebSemiBold" FontSize="14"
                   TextColor="#A0A0A0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="RETRY" BackgroundColor="#E10600" TextColor="#FFFFFF"
                    FontFamily="TitilliumWebBold" FontSize="12" CornerRadius="4" Padding="24,10"
                    Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView IsVisible="{Binding HasData}" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- Session Date -->
                <Label Text="{Binding EventDateText}"
                       FontFamily="TitilliumWebRegular" FontSize="12"
                       TextColor="#9CA3AF" HorizontalOptions="Center"
                       Margin="0,16,0,8" />

                <!-- Results List -->
                <Label Text="No results available for this session."
                       FontFamily="TitilliumWebRegular" FontSize="14"
                       TextColor="#9CA3AF" HorizontalOptions="Center"
                       IsVisible="{Binding IsEmptyState}" Margin="0,20,0,0" />

                <CollectionView ItemsSource="{Binding Results}"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RaceResultEntry">
                            <Border StrokeThickness="1" Stroke="#2a3441" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#1e293b" Padding="14,12" Margin="16,0,16,6">
                                <Grid ColumnDefinitions="32,42,*,Auto" ColumnSpacing="10">
                                    <!-- Position -->
                                    <Label Grid.Column="0" Text="{Binding Position, StringFormat='{0}'}"
                                           FontFamily="TitilliumWebBold" FontSize="17"
                                           VerticalOptions="Center" HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="1">
                                                <Setter Property="TextColor" Value="#FCD34D" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="2">
                                                <Setter Property="TextColor" Value="#E2E8F0" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Position}" Value="3">
                                                <Setter Property="TextColor" Value="#F87171" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <!-- Headshot -->
                                    <Border Grid.Column="1" StrokeThickness="1" Stroke="#2a3441"
                                            StrokeShape="RoundRectangle 21" WidthRequest="42" HeightRequest="42"
                                            BackgroundColor="#0f172a">
                                        <Image Source="{Binding HeadshotUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <!-- Name + Team + Info -->
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding DriverName}" FontFamily="TitilliumWebRegular"
                                                   FontSize="15" TextColor="White" VerticalOptions="Center" />
                                            <Label FontFamily="TitilliumWebRegular" FontSize="10"
                                                   TextColor="#A0A0A0" VerticalOptions="Center"
                                                   IsVisible="{Binding GapToLeader, FallbackValue=False}">
                                                <Label.Text>
                                                    <Binding Path="GapToLeader" />
                                                </Label.Text>
                                            </Label>
                                            <Label FontFamily="TitilliumWebRegular" FontSize="10"
                                                   TextColor="#A0A0A0" VerticalOptions="Center">
                                                <Label.Text>
                                                    <Binding Path="NumberOfLaps"
                                                             StringFormat="{}{0} laps" />
                                                </Label.Text>
                                            </Label>
                                            <Border StrokeThickness="0" BackgroundColor="#B15BE4"
                                                    StrokeShape="RoundRectangle 3" Padding="4,1"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding IsFastestLap}">
                                                <Label Text="FL" FontFamily="TitilliumWebBold" FontSize="8"
                                                       TextColor="White" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TeamName}" FontSize="11" TextColor="#9CA3AF"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <!-- Time / DNF -->
                                    <Label Grid.Column="3" Text="{Binding TimeOrDnf}"
                                           FontFamily="TitilliumWebBold" FontSize="15"
                                           HorizontalTextAlignment="End" VerticalOptions="Center"
                                           TextColor="White">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDnf}" Value="True">
                                                <Setter Property="TextColor" Value="#9CA3AF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
