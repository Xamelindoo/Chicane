<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.PastRaceDetailPage"
             x:DataType="viewmodels:PastRaceDetailViewModel"
             Title="{Binding EventName}"
             BackgroundColor="{StaticResource CarbonBlack}">

    <Grid RowDefinitions="*">
        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource RacingRed}"
                               HeightRequest="48"
                               WidthRequest="48" />
            <Label Text="Loading results..."
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16"
                             Padding="32">
            <Label Text="&#x26A0;"
                   FontSize="48"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource RacingRed}" />
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />
            <Button Text="RETRY"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView IsVisible="{Binding HasData}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- RACE RESULTS -->
                <Label Text="{Binding EventDateText}"
                       FontFamily="SpaceMonoRegular"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />
                <Border Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="16"
                        Margin="20,16,20,0">
                    <Label Text="RACE RESULTS"
                           FontFamily="SpaceMonoBold"
                           FontSize="14"
                           TextColor="{StaticResource RacingRed}"
                           CharacterSpacing="4"
                           HorizontalOptions="Center" />
                </Border>

                <Grid ColumnDefinitions="14,24,*,Auto"
                      Padding="20,8,20,4"
                      ColumnSpacing="6">
                    <Label Grid.Column="1"
                           Text="#"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           CharacterSpacing="2" />
                    <Label Grid.Column="2"
                           Text="DRIVER"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           CharacterSpacing="2" />
                    <Label Grid.Column="3"
                           Text="TIME"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           CharacterSpacing="2"
                           HorizontalTextAlignment="End" />
                </Grid>

                <CollectionView ItemsSource="{Binding Results}"
                                Margin="0,0,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RaceResultEntry">
                            <Grid ColumnDefinitions="14,24,*,Auto"
                                  Padding="20,5"
                                  ColumnSpacing="6">
                                <!-- FL Dot -->
                                <BoxView Grid.Column="0"
                                         WidthRequest="8"
                                         HeightRequest="8"
                                         CornerRadius="4"
                                         Color="#B15BE4"
                                         VerticalOptions="Center"
                                         IsVisible="{Binding IsFastestLap}" />
                                <!-- Position -->
                                <Label Grid.Column="1"
                                       Text="{Binding Position}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="13"
                                       TextColor="{StaticResource PureWhite}"
                                       VerticalOptions="Center" />
                                <!-- Driver -->
                                <VerticalStackLayout Grid.Column="2"
                                                     VerticalOptions="Center"
                                                     Spacing="1">
                                    <Label Text="{Binding DriverName}"
                                           FontFamily="SpaceMonoRegular"
                                           FontSize="12"
                                           TextColor="{StaticResource PureWhite}" />
                                    <Label Text="{Binding TeamName}"
                                           FontSize="10"
                                           TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>
                                <!-- Time or DNF -->
                                <Label Grid.Column="3"
                                       Text="{Binding TimeOrDnf}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="13"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsDnf}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsDnf}"
                                                     Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- YELLOW FLAGS -->
                <Border Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="14"
                        Margin="20,24,20,0">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="&#x1F7E1;"
                               FontSize="16"
                               VerticalOptions="Center" />
                        <Label FontFamily="SpaceMonoRegular"
                               FontSize="12"
                               TextColor="{StaticResource CoolSlate}"
                               VerticalOptions="Center">
<Label.Text>
                                                <Binding Path="YellowFlagCount"
                                                         StringFormat="{}{0} yellow flags" />
                            </Label.Text>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- DRIVER STANDINGS -->
                <Border Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="16"
                        Margin="20,24,20,0">
                    <Label Text="DRIVER STANDINGS"
                           FontFamily="SpaceMonoBold"
                           FontSize="13"
                           TextColor="{StaticResource PureWhite}"
                           CharacterSpacing="3"
                           HorizontalOptions="Center" />
                </Border>

                <Grid ColumnDefinitions="28,*,Auto"
                      Padding="20,8,20,4"
                      ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="#"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Column="1"
                           Text="DRIVER"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Column="2"
                           Text="PTS"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                </Grid>

                <CollectionView ItemsSource="{Binding DriverStandings}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StandingsEntry">
                            <Grid ColumnDefinitions="28,*,Auto"
                                  Padding="20,4"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Position}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="12"
                                       TextColor="{StaticResource PureWhite}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="1">
                                    <Label Text="{Binding DriverName}"
                                           FontFamily="SpaceMonoRegular"
                                           FontSize="12"
                                           TextColor="{StaticResource PureWhite}" />
                                    <Label Text="{Binding TeamName}"
                                           FontSize="9"
                                           TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Points}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="13"
                                       TextColor="{StaticResource RacingRed}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- CONSTRUCTOR STANDINGS -->
                <Border Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="{StaticResource SurfaceLow}"
                        Padding="16"
                        Margin="20,24,20,0">
                    <Label Text="CONSTRUCTOR STANDINGS"
                           FontFamily="SpaceMonoBold"
                           FontSize="13"
                           TextColor="{StaticResource PureWhite}"
                           CharacterSpacing="3"
                           HorizontalOptions="Center" />
                </Border>

                <Grid ColumnDefinitions="28,*,Auto"
                      Padding="20,8,20,4"
                      ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="#"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Column="1"
                           Text="TEAM"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                    <Label Grid.Column="2"
                           Text="PTS"
                           FontFamily="SpaceMonoBold"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                </Grid>

                <CollectionView ItemsSource="{Binding ConstructorStandings}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConstructorStandingsEntry">
                            <Grid ColumnDefinitions="28,*,Auto"
                                  Padding="20,4"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Position}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="12"
                                       TextColor="{StaticResource PureWhite}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding TeamName}"
                                       FontFamily="SpaceMonoRegular"
                                       FontSize="12"
                                       TextColor="{StaticResource PureWhite}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Points}"
                                       FontFamily="SpaceMonoBold"
                                       FontSize="13"
                                       TextColor="{StaticResource RacingRed}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
