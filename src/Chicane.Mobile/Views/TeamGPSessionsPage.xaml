<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Chicane.Mobile.ViewModels"
             xmlns:models="clr-namespace:Chicane.Mobile.Models"
             x:Class="Chicane.Mobile.Views.TeamGPSessionsPage"
             x:DataType="viewmodels:TeamGPSessionsViewModel"
             Title="{Binding MeetingName, FallbackValue='GP Sessions'}"
             BackgroundColor="#0b1320">

    <Grid RowDefinitions="*">

        <!-- Loading -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#E10600" HeightRequest="48" WidthRequest="48" />
            <Label Text="Loading sessions..." FontFamily="TitilliumWebRegular" FontSize="12"
                   TextColor="#666666" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
            <Label Text="&#x26A0;" FontSize="48" HorizontalOptions="Center" TextColor="#E10600" />
            <Label Text="{Binding ErrorMessage}" FontFamily="TitilliumWebSemiBold" FontSize="14"
                   TextColor="#A0A0A0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="RETRY" BackgroundColor="#E10600" TextColor="#FFFFFF"
                    FontFamily="TitilliumWebBold" FontSize="12" CornerRadius="4" Padding="24,10"
                    Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView IsVisible="{Binding HasData}" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- GP Header -->
                <Border StrokeThickness="1" Stroke="#E10600" StrokeShape="RoundRectangle 12"
                        BackgroundColor="#1e293b" Padding="16,14" Margin="16,16,16,0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding MeetingName}"
                               FontFamily="TitilliumWebBold" FontSize="16"
                               TextColor="White" HorizontalOptions="Center" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding TotalPoints}" FontFamily="TitilliumWebBold" FontSize="20"
                                   TextColor="#E10600" VerticalOptions="Center" />
                            <Label Text="pts" FontFamily="TitilliumWebRegular" FontSize="13"
                                   TextColor="#9CA3AF" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Sessions -->
                <Label Text="SESSIONS" FontFamily="TitilliumWebBold" FontSize="13"
                       TextColor="#FFFFFF" CharacterSpacing="3"
                       Margin="20,20,20,8" />

                <CollectionView ItemsSource="{Binding Sessions}"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TeamRaceResult">
                            <Border StrokeThickness="1" Stroke="#2a3441"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#1e293b"
                                    Padding="14,12" Margin="16,0,16,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamGPSessionsViewModel}}, Path=NavigateToSessionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <!-- Row 1: Session name + date / DONE / chevron -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding SessionName}"
                                                   FontFamily="TitilliumWebBold" FontSize="14"
                                                   TextColor="#FFFFFF" />
                                            <Label Text="{Binding EventDate, StringFormat='{0:dd MMM yyyy}'}"
                                                   FontFamily="TitilliumWebRegular" FontSize="11"
                                                   TextColor="#9CA3AF" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="#10B981"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                                Padding="8,3" VerticalOptions="Center">
                                            <Label Text="DONE" FontFamily="TitilliumWebBold"
                                                   FontSize="9" TextColor="White" CharacterSpacing="2" />
                                        </Border>
                                        <Label Grid.Column="2" Text="›" FontSize="20"
                                               TextColor="#9CA3AF" VerticalOptions="Center" />
                                    </Grid>
                                    <!-- Row 2: Driver results -->
                                    <HorizontalStackLayout Spacing="6"
                                                          IsVisible="{Binding HasDriverData}">
                                        <HorizontalStackLayout Spacing="4">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                                    Padding="4,2" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#90111d" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Driver1Position}" Value="1">
                                                                <Setter Property="BackgroundColor" Value="#FFD700" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Driver1Position}" Value="2">
                                                                <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Driver1Position}" Value="3">
                                                                <Setter Property="BackgroundColor" Value="#CD7F32" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="{Binding Driver1Position, StringFormat='P{0}'}"
                                                       FontFamily="TitilliumWebBold" FontSize="10"
                                                       TextColor="#FFFFFF" />
                                            </Border>
                                            <Label Text="{Binding Driver1Code}"
                                                   FontFamily="TitilliumWebRegular" FontSize="12"
                                                   TextColor="White" VerticalOptions="Center" />
                                            <Label Text="{Binding Driver1Points, StringFormat='{0} pts'}"
                                                   FontFamily="TitilliumWebBold" FontSize="12"
                                                   TextColor="#E10600" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="·" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center" />
                                        <HorizontalStackLayout Spacing="4">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                                    Padding="4,2" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#90111d" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Driver2Position}" Value="1">
                                                                <Setter Property="BackgroundColor" Value="#FFD700" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Driver2Position}" Value="2">
                                                                <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Driver2Position}" Value="3">
                                                                <Setter Property="BackgroundColor" Value="#CD7F32" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="{Binding Driver2Position, StringFormat='P{0}'}"
                                                       FontFamily="TitilliumWebBold" FontSize="10"
                                                       TextColor="#FFFFFF" />
                                            </Border>
                                            <Label Text="{Binding Driver2Code}"
                                                   FontFamily="TitilliumWebRegular" FontSize="12"
                                                   TextColor="White" VerticalOptions="Center" />
                                            <Label Text="{Binding Driver2Points, StringFormat='{0} pts'}"
                                                   FontFamily="TitilliumWebBold" FontSize="12"
                                                   TextColor="#E10600" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>
