<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Chicane.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Chicane.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="Schedule"
            ContentTemplate="{DataTemplate views:SchedulePage}"
            Route="schedule" />

        <ShellContent
            Title="Teams"
            ContentTemplate="{DataTemplate views:TeamsPage}"
            Route="teams" />

        <ShellContent
            Title="News"
            ContentTemplate="{DataTemplate views:NewsPage}"
            Route="news" />
    </TabBar>

</Shell>
