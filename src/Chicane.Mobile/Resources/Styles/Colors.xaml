<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Carbon & Neon Palette - Chicane -->
    <Color x:Key="CarbonBlack">#0A0A0A</Color>
    <Color x:Key="DeepBlack">#060606</Color>
    <Color x:Key="TireSmoke">#1A1A1A</Color>
    <Color x:Key="SurfaceLow">#131313</Color>
    <Color x:Key="SurfaceMid">#1E1E1E</Color>
    <Color x:Key="SurfaceHigh">#2A2A2A</Color>
    <Color x:Key="RacingRed">#E10600</Color>
    <Color x:Key="NeonPurple">#B026FF</Color>
    <Color x:Key="PureWhite">#FFFFFF</Color>
    <Color x:Key="CoolSlate">#A0A0A0</Color>
    <Color x:Key="BorderSubtle">#333333</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Primary">#E10600</Color>
    <Color x:Key="PrimaryDark">#B30500</Color>
    <Color x:Key="PrimaryLight">#FF3B33</Color>
    <Color x:Key="Secondary">#B026FF</Color>
    <Color x:Key="Tertiary">#A0A0A0</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#A0A0A0</Color>
    <Color x:Key="TextMuted">#666666</Color>

    <Color x:Key="ErrorColor">#FF4444</Color>
    <Color x:Key="SuccessColor">#00C853</Color>
    <Color x:Key="WarningColor">#FFD600</Color>

</ResourceDictionary>
